{
	email {$ACME_EMAIL}
}

{$WHATSAPP_MCP_DOMAIN} {
	# Caddy obtains and renews the certificate on its own.
	encode gzip

	# The bridge builds its OAuth URLs from WHATSAPP_MCP_PUBLIC_URL, so it needs
	# to know the request arrived over HTTPS on the public hostname.
	reverse_proxy bridge:8080 {
		header_up X-Forwarded-Proto https
		# MCP responses stream over SSE; do not buffer or time them out early.
		flush_interval -1
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
