# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
#
# El archivo .env contiene la frase que protege el acceso a tus mensajes.
# Nunca lo subas a git (ya esta en .gitignore).

# --- Dominio ---------------------------------------------------------------

# El dominio que apunta a este servidor. Necesitas un registro DNS de tipo A
# apuntando a la IP publica de la maquina ANTES de levantar los contenedores,
# o Caddy no podra emitir el certificado.
WHATSAPP_MCP_DOMAIN=wa.tudominio.com

# La misma URL con https://. Es la que pegaras en claude.ai.
WHATSAPP_MCP_PUBLIC_URL=https://wa.tudominio.com

# Correo para los avisos de Let's Encrypt (caducidad de certificados).
ACME_EMAIL=tu@correo.com

# --- Seguridad -------------------------------------------------------------

# La unica credencial del puente. Se te pedira una vez, al conectar Claude.
# Quien la sepa puede leer todos tus mensajes: tratala como la contrasena de tu
# banco. Minimo 12 caracteres; genera una asi:
#   openssl rand -base64 24
WHATSAPP_MCP_PASSPHRASE=

# --- Opciones --------------------------------------------------------------

# Permitir que Claude ENVIE mensajes desde tu numero. Desactivado por defecto:
# con false, Claude solo puede leer y buscar. Activalo solo si lo necesitas.
WHATSAPP_MCP_ALLOW_SEND=false

# Tu zona horaria, para que las fechas de los mensajes salgan correctas.
# Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Bogota

# Logs detallados del protocolo de WhatsApp. Solo para diagnosticar problemas.
WHATSAPP_MCP_DEBUG=false
